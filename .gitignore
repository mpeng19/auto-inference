# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Environments / secrets
.env
.env.*
*.modal.toml

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Experiment outputs
results/
logs/
*.log

# Evaluation artifacts: a Simulator root_dir is a working directory.
# docs/examples/ is the exception -- a committed example of what a run produces.
runs/
*.ipynb_checkpoints/

# macOS
.DS_Store

# Large reference binaries — keep local, not in git history
docs/*.pdf

# Overlaid modules keep a pristine copy alongside them at runtime
*.py.stock
agents/

# Run-specific planning notes: yours, not the repo's
docs/NEXT.md

# Synthetic traces written by tracedb.synth / modal_trace
fixtures/
